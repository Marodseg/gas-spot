# Browser key de Precioil, restringida al origin de GitHub Pages y a localhost.
# No uses una server key: esta variable queda visible en el bundle.
# Solicítala en https://api.precioil.es/
VITE_PRECIOIL_API_KEY=

# Opcional. Permite apuntar a otro host si Precioil cambia de dominio.
VITE_PRECIOIL_BASE_URL=https://api.precioil.es

# Solo hace falta en el build de GitHub Pages de un repositorio de proyecto.
# Ejemplo: /reposta/
VITE_BASE_PATH=/
